+++ b/src/chessiro/glue.h
@@ -0,0 +1,45 @@
+/*
+  Chessiro WebAssembly glue for Stockfish.
+
+  This file is part of the Chessiro build of Stockfish and is licensed under
+  the GNU General Public License v3, like Stockfish itself.
+*/
+
+#ifndef CHESSIRO_GLUE_H_INCLUDED
+#define CHESSIRO_GLUE_H_INCLUDED
+
+#include <string>
+
+#ifndef CHESSIRO_YIELD_MS
+    // Wall-clock interval between yields to the JS event loop (single-threaded
+    // build only). This bounds the latency of 'stop'.
+    #define CHESSIRO_YIELD_MS 25
+#endif
+
+#ifndef CHESSIRO_MAX_THREADS
+    #define CHESSIRO_MAX_THREADS 64
+#endif
+
+// Blocks until the JS side pushes a command (multi-threaded build).
+std::string chessiro_getline();
+
+extern "C" {
+
+#if defined(CHESSIRO_SINGLE_THREADED) && defined(CHESSIRO_NO_YIELD)
+// Measurement-only build: no Asyncify, 'stop' cannot interrupt a search.
+inline void chessiro_yield() {}
+#elif defined(CHESSIRO_SINGLE_THREADED)
+// Suspends the wasm (Asyncify) until the JS event loop has had a turn.
+// Defined with EM_ASYNC_JS in glue.cpp; the import attribute must match it.
+__attribute__((import_module("env"), import_name("__asyncjs__chessiro_yield"))) void
+chessiro_yield();
+#endif
+
+// Entry point used by JS for every UCI line.
+void chessiro_command(const char* utf8);
+}
+
+// Multi-threaded build: called once the UCI loop has exited after 'quit'.
+void chessiro_notify_quit();
+
+#endif  // CHESSIRO_GLUE_H_INCLUDED
