+// Assembled separately (no LTO) with -DCHESSIRO_NNUE_FILE="nn-....nnue".
+    .section .rodata.gEmbeddedNNUEData,"",@
+    .globl gEmbeddedNNUEData
+    .type gEmbeddedNNUEData,@object
