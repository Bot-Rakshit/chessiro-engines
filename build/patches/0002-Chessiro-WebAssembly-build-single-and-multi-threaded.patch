+++ b/src/chessiro/Makefile
@@ -0,0 +1,151 @@
+# Chessiro WebAssembly build of Stockfish.
+#
+# Usage (from the Stockfish `src` directory):
+#
+#   make -f chessiro/Makefile FLAVOR=st  SIMD=simd      # single-threaded, wasm SIMD
+#   make -f chessiro/Makefile FLAVOR=mt  SIMD=simd      # pthreads, needs SharedArrayBuffer
+#   make -f chessiro/Makefile FLAVOR=st  SIMD=relaxed   # + relaxed-simd dot products
+#   make -f chessiro/Makefile FLAVOR=st  SIMD=nosimd    # scalar fallback for old devices
+#
+# Optional:
+#   PGO=gen | PGO=use PROFILE=path.profdata   profile guided optimisation
+#   OUTDIR=...                                 where to put the .js/.wasm
+#   NAME=...                                   output basename (default sf19-$(FLAVOR)[-$(SIMD)])
+#   DEBUG=1                                    -O1 -g, assertions, no closure
+
+FLAVOR ?= st
+SIMD   ?= simd
+OUTDIR ?= chessiro/out
+PGO    ?=
+DEBUG  ?=
+YIELD_MS ?= 25
+
+ifeq ($(SIMD),simd)
+  NAME ?= sf19-$(FLAVOR)
+else
+  NAME ?= sf19-$(FLAVOR)-$(SIMD)
+endif
+
+CXX = em++
+
+SRCS = attacks.cpp benchmark.cpp bitboard.cpp evaluate.cpp main.cpp \
+	misc.cpp movegen.cpp movepick.cpp position.cpp \
+	search.cpp thread.cpp timeman.cpp tt.cpp uci.cpp ucioption.cpp tune.cpp syzygy/tbprobe.cpp \
+	nnue/nnue_accumulator.cpp nnue/nnue_misc.cpp nnue/network.cpp \
+	nnue/features/p_hm.cpp \
+	engine.cpp score.cpp memory.cpp chessiro/glue.cpp
+
+OBJDIR = chessiro/obj/$(NAME)$(if $(PGO),-pgo$(PGO),)
+OBJS   = $(addprefix $(OBJDIR)/,$(SRCS:.cpp=.o)) $(OBJDIR)/chessiro/nnue_blob.o
+DEPS   = $(filter %.d,$(OBJS:.o=.d))
+
+# Default network name, read from evaluate.h like the upstream Makefile does.
+NNUE_FILE := $(shell grep -E '^\#define EvalFileDefaultName ' evaluate.h | sed -E 's/.*"([^"]+)".*/\1/')
+
+TAG = wasm-$(FLAVOR)$(if $(filter-out simd,$(SIMD)),-$(SIMD),)
+
+# ---------------------------------------------------------------------------
+# Compiler flags
+
+CXXFLAGS = -std=c++17 -Wall -Wcast-qual -fno-exceptions -fno-rtti -I. \
+	-DNDEBUG -DIS_64BIT -DUSE_POPCNT -DNO_PREFETCH -DUSE_SLOPPY_ATOMICS -DNO_TABLEBASES \
+	-DARCH=wasm32 -DCHESSIRO_WASM -DCHESSIRO_EMBED_NNUE -DCHESSIRO_BUILD_TAG=$(TAG) \
+	-DCHESSIRO_YIELD_MS=$(YIELD_MS)
+
+ifeq ($(DEBUG),)
+  CXXFLAGS += -O3 -funroll-loops -flto
+  LDFLAGS_OPT = -O3 -flto --closure 1
+else
+  CXXFLAGS += -O1 -g -UNDEBUG
+  LDFLAGS_OPT = -O1 -g -sASSERTIONS=1
+endif
+
+ifeq ($(SIMD),simd)
+  CXXFLAGS += -msimd128 -msse -msse2 -mssse3 -msse4.1 -DUSE_SSE2 -DUSE_SSSE3 -DUSE_SSE41
+endif
+ifeq ($(SIMD),relaxed)
+  CXXFLAGS += -msimd128 -mrelaxed-simd -msse -msse2 -mssse3 -msse4.1 -DUSE_SSE2 -DUSE_SSSE3 -DUSE_SSE41
+endif
+ifeq ($(SIMD),nosimd)
+  # scalar code paths only
+endif
+
+ifeq ($(FLAVOR),st)
+  CXXFLAGS += -DCHESSIRO_SINGLE_THREADED
+  ifeq ($(NOYIELD),1)
+    CXXFLAGS += -DCHESSIRO_NO_YIELD
+  endif
+  ST_JS = true
+else
+  CXXFLAGS += -pthread
+  ST_JS = false
+endif
+
+ifeq ($(PGO),gen)
+  CXXFLAGS += -fprofile-instr-generate -DCHESSIRO_PGO_GEN
+endif
+ifeq ($(PGO),use)
+  CXXFLAGS += -fprofile-instr-use=$(PROFILE) -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date
+endif
+
+# ---------------------------------------------------------------------------
+# Linker flags
+
+LDFLAGS = $(LDFLAGS_OPT) \
+	-sMODULARIZE=1 -sEXPORT_NAME=ChessiroStockfishFactory \
+	-sENVIRONMENT=web,worker,node \
+	-sEXPORTED_FUNCTIONS=_main,_chessiro_command \
+	-sEXPORTED_RUNTIME_METHODS=ccall \
+	-sINCOMING_MODULE_JS_API=locateFile,print,printErr,instantiateWasm,wasmBinary,mainScriptUrlOrBlob,onAbort,onQuit \
+	-sINITIAL_MEMORY=64MB -sALLOW_MEMORY_GROWTH=1 -sMAXIMUM_MEMORY=2GB \
+	-sFILESYSTEM=0 -sEXIT_RUNTIME=0 -sTEXTDECODER=2 \
+	-sMIN_SAFARI_VERSION=160400 \
+	--pre-js chessiro/pre.js \
+	--extern-post-js $(OBJDIR)/post.js
+
+ifeq ($(FLAVOR),st)
+  ifeq ($(NOYIELD),1)
+    LDFLAGS += -sSTACK_SIZE=4MB
+  else
+    LDFLAGS += -sASYNCIFY=1 -sASYNCIFY_IGNORE_INDIRECT=1 -sASYNCIFY_STACK_SIZE=8388608 \
+	-sSTACK_SIZE=4MB
+  endif
+else
+  LDFLAGS += -pthread -sPROXY_TO_PTHREAD=1 -sSTACK_SIZE=3MB \
+	-sPTHREAD_POOL_SIZE=0 -sPTHREAD_POOL_SIZE_STRICT=0 -Wno-pthreads-mem-growth
+endif
+
+ifeq ($(PGO),gen)
+  LDFLAGS += -fprofile-instr-generate -sNODERAWFS=1 -sFILESYSTEM=1 -sEXPORTED_FUNCTIONS=_main,_chessiro_command,_chessiro_flush_profile
+  LDFLAGS_OPT := $(filter-out --closure 1,$(LDFLAGS_OPT))
+endif
+
+# ---------------------------------------------------------------------------
+
+.PHONY: all clean
+
+all: $(OUTDIR)/$(NAME).js
+
+$(OUTDIR)/$(NAME).js: $(OBJS) $(OBJDIR)/post.js chessiro/pre.js | $(OUTDIR)
+	$(CXX) $(CXXFLAGS) $(LDFLAGS) $(OBJS) -o $@
+	@ls -la $(OUTDIR)/$(NAME).js $(OUTDIR)/$(NAME).wasm
+
+$(OBJDIR)/post.js: chessiro/post.js | $(OBJDIR)
+	sed -e 's/CHESSIRO_FACTORY/ChessiroStockfishFactory/g' -e 's/CHESSIRO_SINGLE_THREADED_JS/$(ST_JS)/g' $< > $@
+
+$(OBJDIR)/%.o: %.cpp | $(OBJDIR)
+	@mkdir -p $(dir $@)
+	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@
+
+# The network blob is assembled without LTO so that the symbol types survive.
+$(OBJDIR)/chessiro/nnue_blob.o: chessiro/nnue_blob.S $(NNUE_FILE) | $(OBJDIR)
+	@mkdir -p $(dir $@)
+	$(CXX) -DCHESSIRO_NNUE_FILE='"$(NNUE_FILE)"' -c $< -o $@
+
+$(OBJDIR) $(OUTDIR):
+	mkdir -p $@
+
+clean:
+	rm -rf chessiro/obj $(OUTDIR)
+
+-include $(DEPS)
diff --git a/src/chessiro/glue.cpp b/src/chessiro/glue.cpp
new file mode 100644
index 00000000..e3b76f4f
--- /dev/null
+++ b/src/chessiro/glue.cpp
@@ -0,0 +1,135 @@
+/*
+  Chessiro WebAssembly glue for Stockfish.
+
+  This file is part of the Chessiro build of Stockfish and is licensed under
+  the GNU General Public License v3, like Stockfish itself.
+
+  Two flavours are produced from the same sources:
+
+  * Multi-threaded (pthreads / SharedArrayBuffer). main() runs the regular UCI
+    loop on its own pthread (PROXY_TO_PTHREAD) and blocks on a command queue
+    that JS fills from the Worker's onmessage handler. Search threads are
+    ordinary pthreads, exactly like the native engine.
+
+  * Single-threaded (no SharedArrayBuffer needed). There are no threads at all.
+    JS calls chessiro_command() for each UCI line; 'go' runs the whole search
+    synchronously on the Worker's thread, periodically suspending via Asyncify
+    (chessiro_yield) so that the event loop can deliver 'stop'.
+*/
+
+#include "glue.h"
+
+#include <cstdlib>
+#include <string>
+
+#include <emscripten.h>
+
+#include "../uci.h"
+
+using namespace Stockfish;
+
+extern UCIEngine* chessiro_uci;  // main.cpp
+
+#ifdef CHESSIRO_PGO_GEN
+// Instrumented builds: let JS dump the raw profile before the process exits.
+extern "C" int __llvm_profile_write_file(void);
+extern "C" EMSCRIPTEN_KEEPALIVE int chessiro_flush_profile() { return __llvm_profile_write_file(); }
+#endif
+
+#ifdef CHESSIRO_SINGLE_THREADED
+
+// Yield implementation.
+//
+// Browsers: a MessageChannel round trip. Unlike setTimeout(0), which browsers
+// clamp to >= 1ms (4ms once nested), it costs microseconds, and it shares the
+// "posted message" task source with the parent's Worker.postMessage(), so a
+// pending 'stop' is guaranteed to run before we resume.
+//
+// Node: setImmediate. Node drains same-thread MessagePort queues in a loop
+// without returning to the event loop, which would starve stdin and timers.
+// clang-format off
+#ifndef CHESSIRO_NO_YIELD
+EM_ASYNC_JS(void, chessiro_yield, (), {
+    await new Promise(function(resolve) {
+        if (typeof setImmediate === "function" && typeof process === "object" && process["versions"] && process["versions"]["node"]) {
+            setImmediate(resolve);
+        } else if (typeof MessageChannel === "function") {
+            var ch = Module["$yieldChannel"];
+            if (!ch) {
+                ch = Module["$yieldChannel"] = new MessageChannel();
+                ch.port1.onmessage = function() {
+                    var r = Module["$yieldResolve"];
+                    Module["$yieldResolve"] = null;
+                    if (r) r();
+                };
+            }
+            Module["$yieldResolve"] = resolve;
+            ch.port2.postMessage(0);
+        } else {
+            setTimeout(resolve, 0);
+        }
+    });
+});
+#endif
+// clang-format on
+
+std::string chessiro_getline() { return "quit"; }  // never used in this flavour
+void        chessiro_notify_quit() {}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void chessiro_command(const char* utf8) {
+    if (chessiro_uci && utf8)
+        chessiro_uci->process_command(std::string(utf8));
+}
+
+#else  // multi-threaded
+
+    #include <condition_variable>
+    #include <mutex>
+    #include <queue>
+
+namespace {
+
+struct CommandQueue {
+    std::mutex              m;
+    std::condition_variable cv;
+    std::queue<std::string> q;
+
+    void push(std::string s) {
+        {
+            std::lock_guard<std::mutex> lk(m);
+            q.push(std::move(s));
+        }
+        cv.notify_one();
+    }
+
+    std::string pop() {
+        std::unique_lock<std::mutex> lk(m);
+        cv.wait(lk, [&] { return !q.empty(); });
+        std::string s = std::move(q.front());
+        q.pop();
+        return s;
+    }
+};
+
+CommandQueue inQ;
+
+}  // namespace
+
+std::string chessiro_getline() { return inQ.pop(); }
+
+void chessiro_notify_quit() {
+    // clang-format off
+    MAIN_THREAD_ASYNC_EM_ASM({
+        if (Module["onQuit"]) Module["onQuit"]();
+    });
+    // clang-format on
+}
+
+// Called on the JS side's thread (the Worker's main thread). Only touches the
+// queue, so it never blocks for long even though that thread cannot Atomics.wait.
+extern "C" EMSCRIPTEN_KEEPALIVE void chessiro_command(const char* utf8) {
+    if (utf8)
+        inQ.push(std::string(utf8));
+}
+
+#endif
